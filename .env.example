# Database Configuration
# Option A: Discrete variables (MySQL or PostgreSQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Option B: Direct connection string (PostgreSQL or SQLite fallback)
# DATABASE_URL=postgresql://user:password@localhost:5432/food_packaging_db
# DATABASE_URL=sqlite:///food_packaging.db

# Test Database Configuration (Isolated in-memory database)
TEST_DATABASE_URL=sqlite:///:memory:

# Frontend and CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Google OAuth 2.0 Credentials (Backend only — DO NOT expose to frontend or commit real secrets)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=FoodPack AI
SMTP_FROM_EMAIL=your_email@gmail.com

# Authentication Security
AUTH_SECRET_KEY=generate_a_secure_random_secret_key_here
SECRET_KEY=generate_a_secure_random_secret_key_here

