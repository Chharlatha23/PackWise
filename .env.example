# Database Configuration
# Production/Development PostgreSQL Example:
# DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/food_packaging_db
# Lightweight Local SQLite Example:
DATABASE_URL=sqlite:///food_packaging.db

# Test Database Configuration (Isolated in-memory database)
TEST_DATABASE_URL=sqlite:///:memory:

# Frontend and CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
